@page "/test"

<!DOCTYPE html>
<html lang="pl" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReShare - Dziel się i wymieniaj</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
            tailwind.config = {
              darkMode: 'class',
              theme: {
                extend: {
                  colors: {
                    brand: {
                      50: '#f0fdfa',
                      100: '#ccfbf1',
                      200: '#99f6e4',
                      300: '#5eead4',
                      400: '#2dd4bf',
                      500: '#14b8a6',
                      600: '#0d9488',
                      700: '#0f766e',
                      800: '#115e59',
                      900: '#134e4a',
                    },
                    accent: '#84cc16'
                  },
                  fontFamily: {
                    sans: ['Inter', 'sans-serif'],
                  }
                }
              }
            }
    </script>
    <style>
            /* Custom scrollbar styling */
            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 9999px;
            }

            .dark ::-webkit-scrollbar-thumb {
                background: #475569;
            }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 dark:bg-slate-900 dark:text-slate-100 font-sans transition-colors duration-200 min-h-full flex flex-col">

    <!-- TOP HEADER -->
    <header class="sticky top-0 z-30 bg-white/90 dark:bg-slate-800/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-700 px-4 lg:px-8 py-3 shadow-sm">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">

            <!-- LOGO -->
            <div class="flex items-center justify-between w-full sm:w-auto">
                <a href="#" class="flex items-center gap-2 group">
                    <div class="w-10 h-10 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-xl shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </div>
                    <span class="text-2xl font-bold tracking-tight text-brand-700 dark:text-brand-400 italic">ReShare</span>
                </a>

                <!-- Mobile Quick Action Buttons -->
                <div class="flex sm:hidden items-center gap-2">
                    <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                        <i class="fa-solid fa-moon dark:hidden"></i>
                        <i class="fa-solid fa-sun hidden dark:block text-amber-400"></i>
                    </button>
                    <button onclick="openLoginModal()" class="p-2 rounded-lg bg-brand-600 text-white font-medium text-sm">
                        Zaloguj
                    </button>
                </div>
            </div>

            <!-- SEARCH BAR -->
            <div class="flex items-center gap-2 w-full sm:max-w-xl">
                <div class="relative w-full">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="searchInput" oninput="filterOffers()" placeholder="Szukaj przedmiotu (np. książka, kurtka)..."
                           class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all text-sm">
                </div>
                <button onclick="toggleFilterModal()" class="flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white px-4 py-2.5 rounded-xl transition-all shadow-sm shrink-0 font-medium text-sm">
                    <i class="fa-solid fa-sliders"></i>
                    <span class="hidden md:inline">Sortuj/Filtruj</span>
                </button>
            </div>

            <!-- DESKTOP TOP RIGHT NAV -->
            <div class="hidden sm:flex items-center gap-3">
                <button onclick="toggleDarkMode()" title="Zmień motyw" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">
                    <i class="fa-solid fa-moon dark:hidden"></i>
                    <i class="fa-solid fa-sun hidden dark:block text-amber-400"></i>
                </button>
                <button onclick="openLoginModal()" class="bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 px-4 py-2.5 rounded-xl font-medium text-sm transition-colors">
                    Zaloguj się
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 lg:px-8 py-6 flex-grow w-full">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <!-- LEFT COLUMN: OFFERS GRID (3 COLS ON LARGE SCREEN) -->
            <section class="lg:col-span-3 space-y-4">

                <!-- Category Pill Bar -->
                <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none text-sm">
                    <button onclick="filterCategory('Wszystkie')" class="cat-pill active bg-brand-600 text-white px-4 py-1.5 rounded-full font-medium shrink-0 transition-colors">Wszystkie</button>
                    <button onclick="filterCategory('Dom')" class="cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors">Dom i ogród</button>
                    <button onclick="filterCategory('Odzież')" class="cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors">Odzież</button>
                    <button onclick="filterCategory('Książki')" class="cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors">Książki</button>
                    <button onclick="filterCategory('Narzędzia')" class="cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors">Narzędzia</button>
                    <button onclick="filterCategory('Elektronika')" class="cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors">Elektronika</button>
                </div>

                <!-- Offers Grid -->
                <div id="offersGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                    <!-- Dynamically populated via JS -->
                </div>

            </section>

            <!-- RIGHT COLUMN: SIDEBAR PANEL -->
            <aside class="space-y-5">

                <!-- PROFILE CARD -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <h2 class="text-xs uppercase tracking-wider font-bold text-slate-400 mb-3">Twój profil</h2>
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-full bg-brand-100 dark:bg-brand-900/50 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold text-lg border-2 border-brand-500">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div>
                            <h3 class="font-semibold text-slate-900 dark:text-white">Jan Kowalski</h3>
                            <button onclick="openLoginModal()" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Edytuj profil / Zaloguj</button>
                        </div>
                    </div>
                </div>

                <!-- MESSAGES / CHAT QUICK LINK -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-xs uppercase tracking-wider font-bold text-slate-400">Czat</h2>
                        <span class="bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">3 nowe</span>
                    </div>
                    <button onclick="openChatModal()" class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-700/50 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors text-left group">
                        <div class="flex items-center gap-3">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" class="w-10 h-10 rounded-full object-cover" alt="Ania Nowak">
                                <span class="w-3 h-3 bg-emerald-500 border-2 border-white dark:border-slate-800 rounded-full absolute bottom-0 right-0"></span>
                            </div>
                            <div>
                                <p class="font-medium text-sm text-slate-900 dark:text-white group-hover:text-brand-600 transition-colors">Ania Nowak</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate max-w-[140px]">Możemy w centrum w sobotę?</p>
                            </div>
                        </div>
                        <i class="fa-solid fa-chevron-right text-xs text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <!-- FAVORITES PREVIEW -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="text-xs uppercase tracking-wider font-bold text-slate-400">Polubione</h2>
                        <span id="favCount" class="text-xs font-bold text-brand-600 dark:text-brand-400">0 przedmiotów</span>
                    </div>
                    <div id="favoritesList" class="space-y-2 text-xs text-slate-500">
                        <p class="italic py-2 text-center text-slate-400">Brak polubionych ofert. Kliknij <i class="fa-regular fa-heart text-red-500"></i> na karcie.</p>
                    </div>
                </div>

                <!-- NAVIGATION & CATEGORIES LINK LIST -->
                <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm space-y-3">
                    <h2 class="text-xs uppercase tracking-wider font-bold text-slate-400 mb-1">Nawigacja</h2>

                    <a href="#" class="flex items-center gap-3 text-sm font-medium p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors">
                        <i class="fa-solid fa-list-check w-5 text-brand-600"></i>
                        <span>Moje ogłoszenia</span>
                    </a>
                    <a href="#" class="flex items-center gap-3 text-sm font-medium p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors">
                        <i class="fa-solid fa-clock-rotate-left w-5 text-brand-600"></i>
                        <span>Historia transakcji</span>
                    </a>
                    <button onclick="toggleDarkMode()" class="w-full flex items-center justify-between text-sm font-medium p-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 transition-colors text-left">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-moon w-5 text-brand-600"></i>
                            <span>Tryb ciemny</span>
                        </div>
                        <span class="text-xs bg-slate-200 dark:bg-slate-700 px-2 py-0.5 rounded text-slate-600 dark:text-slate-300">Przełącz</span>
                    </button>
                </div>

                <!-- ADD OFFER BUTTON -->
                <button onclick="openAddOfferModal()" class="w-full bg-accent hover:bg-lime-600 text-slate-900 font-bold py-3.5 px-4 rounded-2xl shadow-lg shadow-lime-500/20 flex items-center justify-center gap-2 text-base transition-all transform active:scale-95">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span>Dodaj ofertę</span>
                </button>

            </aside>
        </div>
    </main>

    <!-- MODAL: LOGIN -->
    <div id="loginModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-800 w-full max-w-md rounded-3xl p-6 shadow-2xl border border-slate-200 dark:border-slate-700 relative animate-in fade-in zoom-in duration-150">
            <button onclick="closeLoginModal()" class="absolute right-4 top-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <div class="text-center mb-6">
                <div class="w-12 h-12 rounded-xl bg-brand-600 text-white flex items-center justify-center font-bold text-2xl mx-auto mb-2">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Logowanie</h2>
                <p class="text-xs text-slate-500 mt-1">Witaj ponownie w społeczności ReShare</p>
            </div>

            <form onsubmit="event.preventDefault(); closeLoginModal();" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Adres E-mail</label>
                    <div class="relative">
                        <i class="fa-regular fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="email" required placeholder="twoj@email.com" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Hasło</label>
                    <div class="relative">
                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" required placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm focus:ring-2 focus:ring-brand-500 outline-none">
                    </div>
                    <div class="text-right mt-1">
                        <a href="#" class="text-xs text-brand-600 dark:text-brand-400 hover:underline">Nie pamiętam hasła?</a>
                    </div>
                </div>

                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-semibold py-3 rounded-xl transition-colors shadow-md shadow-brand-500/20">
                    Zaloguj się
                </button>
            </form>

            <div class="my-4 flex items-center gap-3">
                <div class="h-px bg-slate-200 dark:bg-slate-700 flex-1"></div>
                <span class="text-xs text-slate-400">Zaloguj się za pomocą</span>
                <div class="h-px bg-slate-200 dark:bg-slate-700 flex-1"></div>
            </div>

            <!-- Social login buttons -->
            <div class="flex justify-center gap-4">
                <button class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-700 text-red-500">
                    <i class="fa-brands fa-google"></i>
                </button>
                <button class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-700 text-blue-600">
                    <i class="fa-brands fa-facebook-f"></i>
                </button>
                <button class="w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 flex items-center justify-center hover:bg-slate-50 dark:hover:bg-slate-700 text-red-600 font-bold text-xs">
                    mObywatel
                </button>
            </div>

            <p class="text-center text-xs text-slate-500 mt-5">
                Nie masz konta? <a href="#" class="text-brand-600 dark:text-brand-400 font-semibold hover:underline">Zarejestruj się</a>
            </p>
        </div>
    </div>

    <!-- MODAL: CHAT -->
    <div id="chatModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-2 sm:p-4 hidden">
        <div class="bg-white dark:bg-slate-800 w-full max-w-2xl h-[550px] rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-700 flex flex-col overflow-hidden animate-in fade-in duration-150">

            <!-- Chat Header -->
            <div class="p-4 bg-brand-700 text-white flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-brand-500 flex items-center justify-center font-bold text-sm">
                        AN
                    </div>
                    <div>
                        <h3 class="font-bold text-sm">Ania Nowak</h3>
                        <span class="text-[11px] text-brand-200 flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span> ONLINE
                        </span>
                    </div>
                </div>
                <button onclick="closeChatModal()" class="text-brand-200 hover:text-white text-xl">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Chat Body (Sidebar + Messages) -->
            <div class="flex-1 flex overflow-hidden">

                <!-- Conversation List (Left side of chat) -->
                <div class="w-1/3 border-r border-slate-200 dark:border-slate-700 hidden sm:block overflow-y-auto bg-slate-50 dark:bg-slate-900/50">
                    <div class="p-3 border-b border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-400">Rozmowy</div>

                    <div class="p-3 bg-white dark:bg-slate-800 border-l-4 border-brand-500 flex items-center gap-2 cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover">
                        <div class="overflow-hidden">
                            <p class="text-xs font-semibold truncate">Ania Nowak</p>
                            <p class="text-[10px] text-slate-400 truncate">Możemy w centrum...</p>
                        </div>
                    </div>

                    <div class="p-3 hover:bg-slate-100 dark:hover:bg-slate-800 flex items-center gap-2 cursor-pointer transition-colors">
                        <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover">
                        <div class="overflow-hidden">
                            <p class="text-xs font-semibold truncate">Jan Kowalski</p>
                            <p class="text-[10px] text-slate-400 truncate">Dzięki za książkę!</p>
                        </div>
                    </div>
                </div>

                <!-- Active Message Area -->
                <div class="flex-1 flex flex-col bg-white dark:bg-slate-800">
                    <div id="chatMessages" class="flex-1 p-4 overflow-y-auto space-y-3">

                        <!-- Message 1 (Other) -->
                        <div class="flex flex-col items-start max-w-[80%]">
                            <span class="text-[10px] text-slate-400 mb-0.5">Jan (14:20)</span>
                            <div class="bg-slate-100 dark:bg-slate-700 p-3 rounded-2xl rounded-tl-none text-xs text-slate-800 dark:text-slate-100">
                                Cześć, jestem zainteresowany tą kurtką. Czy oferta jest nadal aktualna?
                            </div>
                        </div>

                        <!-- Message 2 (Me) -->
                        <div class="flex flex-col items-end max-w-[80%] ml-auto">
                            <span class="text-[10px] text-slate-400 mb-0.5">Ty (14:22)</span>
                            <div class="bg-brand-600 text-white p-3 rounded-2xl rounded-tr-none text-xs shadow-sm">
                                Cześć Jan! Tak, kurtka jest wolna i gotowa do odbioru.
                            </div>
                        </div>

                        <!-- Message 3 (Other) -->
                        <div class="flex flex-col items-start max-w-[80%]">
                            <span class="text-[10px] text-slate-400 mb-0.5">Jan (14:25)</span>
                            <div class="bg-slate-100 dark:bg-slate-700 p-3 rounded-2xl rounded-tl-none text-xs text-slate-800 dark:text-slate-100">
                                Gdzie i kiedy możemy się umówić?
                            </div>
                        </div>

                        <!-- Message 4 (Me) -->
                        <div class="flex flex-col items-end max-w-[80%] ml-auto">
                            <span class="text-[10px] text-slate-400 mb-0.5">Ty (14:26)</span>
                            <div class="bg-brand-600 text-white p-3 rounded-2xl rounded-tr-none text-xs shadow-sm">
                                Możemy w centrum w sobotę około godziny 12:00?
                            </div>
                        </div>

                    </div>

                    <!-- Chat Input -->
                    <form onsubmit="sendChatMessage(event)" class="p-3 border-t border-slate-200 dark:border-slate-700 flex items-center gap-2 bg-slate-50 dark:bg-slate-900">
                        <input type="text" id="chatInput" placeholder="Wpisz wiadomość..." class="flex-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-4 py-2 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 outline-none">
                        <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white w-9 h-9 rounded-xl flex items-center justify-center transition-colors shrink-0">
                            <i class="fa-solid fa-paper-plane text-xs"></i>
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>

    <!-- MODAL: ADD OFFER -->
    <div id="addOfferModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-800 w-full max-w-lg rounded-3xl p-6 shadow-2xl border border-slate-200 dark:border-slate-700 relative">
            <button onclick="closeAddOfferModal()" class="absolute right-4 top-4 text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <h2 class="text-xl font-bold mb-4 text-slate-900 dark:text-white">Dodaj nową ofertę</h2>

            <form onsubmit="addNewOffer(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold mb-1">Tytuł przedmiotu</label>
                    <input type="text" id="newTitle" required placeholder="np. Książka 'Wiedźmin', Kurtka zimowa" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold mb-1">Kategoria</label>
                        <select id="newCategory" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm outline-none focus:ring-2 focus:ring-brand-500">
                            <option value="Książki">Książki</option>
                            <option value="Odzież">Odzież</option>
                            <option value="Dom">Dom i ogród</option>
                            <option value="Narzędzia">Narzędzia</option>
                            <option value="Elektronika">Elektronika</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold mb-1">Lokalizacja</label>
                        <input type="text" id="newLocation" required placeholder="np. Warszawa" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm outline-none focus:ring-2 focus:ring-brand-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold mb-1">URL Zdjęcia (opcjonalnie)</label>
                    <input type="url" id="newImageUrl" placeholder="https://..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm outline-none focus:ring-2 focus:ring-brand-500">
                </div>

                <button type="submit" class="w-full bg-accent hover:bg-lime-600 text-slate-900 font-bold py-3 rounded-xl transition-colors shadow-md">
                    Opublikuj ofertę
                </button>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
            // Sample Initial Data matching sketch icons & images
            const initialOffers = [
              { id: 1, title: 'Książki klasyczne', category: 'Książki', location: 'Warszawa', image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 2, title: 'Kurtka męska', category: 'Odzież', location: 'Kraków', image: 'https://images.unsplash.com/photo-1551028719-00167b16eac5?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 3, title: 'Akcesoria domowe', category: 'Dom', location: 'Kraków', image: 'https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 4, title: 'Notatnik & Akcesoria', category: 'Książki', location: 'Warszawa', image: 'https://images.unsplash.com/photo-1517842645767-c639042777db?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 5, title: 'Poduszki ozdobne', category: 'Dom', location: 'Warszawa', image: 'https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 6, title: 'Dzbanek ceramiczny', category: 'Dom', location: 'Kraków', image: 'https://images.unsplash.com/photo-1610701596007-11502861dcfa?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 7, title: 'Lampa stojąca & roślina', category: 'Dom', location: 'Warszawa', image: 'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?w=500&auto=format&fit=crop&q=80', liked: false },
              { id: 8, title: 'Zestaw narzędzi', category: 'Narzędzia', location: 'Kraków', image: 'https://images.unsplash.com/photo-1530124566582-a618bc2615dc?w=500&auto=format&fit=crop&q=80', liked: false }
            ];

            let offers = [...initialOffers];
            let selectedCategory = 'Wszystkie';

            // RENDER OFFERS GRID
            function renderOffers() {
              const grid = document.getElementById('offersGrid');
              const searchTerm = document.getElementById('searchInput').value.toLowerCase();

              const filtered = offers.filter(offer => {
                const matchesCategory = selectedCategory === 'Wszystkie' || offer.category === selectedCategory;
                const matchesSearch = offer.title.toLowerCase().includes(searchTerm) || offer.location.toLowerCase().includes(searchTerm);
                return matchesCategory && matchesSearch;
              });

              if(filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400">Brak ofert spełniających kryteria.</div>`;
                return;
              }

              grid.innerHTML = filtered.map(offer => `
                <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden shadow-sm hover:shadow-md transition-all group flex flex-col">
                  <div class="relative h-48 overflow-hidden bg-slate-100 dark:bg-slate-900">
                    <img src="${offer.image}" alt="${offer.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                    <button onclick="toggleLike(${offer.id})" class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 backdrop-blur-md flex items-center justify-center text-red-500 shadow-md hover:scale-110 transition-transform">
                      <i class="${offer.liked ? 'fa-solid' : 'fa-regular'} fa-heart text-base"></i>
                    </button>
                    <span class="absolute bottom-3 left-3 bg-slate-900/60 backdrop-blur-md text-white text-[11px] px-2.5 py-1 rounded-full font-medium">
                      ${offer.category}
                    </span>
                  </div>
                  <div class="p-4 flex-1 flex flex-col justify-between">
                    <div>
                      <h3 class="font-bold text-slate-900 dark:text-white text-base group-hover:text-brand-600 transition-colors">${offer.title}</h3>
                      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                        <i class="fa-solid fa-location-dot text-brand-500"></i> ${offer.location}
                      </p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700/50 flex items-center justify-between">
                      <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2 py-0.5 rounded">Za darmo / Wymiana</span>
                      <button onclick="openChatModal()" class="text-xs font-medium text-brand-600 dark:text-brand-400 hover:underline">Zapytaj</button>
                    </div>
                  </div>
                </div>
              `).join('');

              updateFavoritesUI();
            }

            // LIKE TOGGLE
            function toggleLike(id) {
              const offer = offers.find(o => o.id === id);
              if(offer) {
                offer.liked = !offer.liked;
                renderOffers();
              }
            }

            // UPDATE FAVORITES PANEL
            function updateFavoritesUI() {
              const favs = offers.filter(o => o.liked);
              const favCount = document.getElementById('favCount');
              const favList = document.getElementById('favoritesList');

              favCount.textContent = `${favs.length} ofert`;

              if(favs.length === 0) {
                favList.innerHTML = `<p class="italic py-2 text-center text-slate-400">Brak polubionych ofert. Kliknij <i class="fa-regular fa-heart text-red-500"></i> na karcie.</p>`;
              } else {
                favList.innerHTML = favs.map(f => `
                  <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-slate-700/50">
                    <div class="flex items-center gap-2 truncate">
                      <img src="${f.image}" class="w-8 h-8 rounded object-cover">
                      <span class="truncate font-medium text-slate-700 dark:text-slate-200">${f.title}</span>
                    </div>
                    <button onclick="toggleLike(${f.id})" class="text-red-500 hover:text-red-700 ml-2">
                      <i class="fa-solid fa-heart"></i>
                    </button>
                  </div>
                `).join('');
              }
            }

            // CATEGORY FILTERING
            function filterCategory(cat) {
              selectedCategory = cat;
              document.querySelectorAll('.cat-pill').forEach(btn => {
                if(btn.textContent.includes(cat) || (cat==='Wszystkie' && btn.textContent==='Wszystkie')) {
                  btn.className = 'cat-pill bg-brand-600 text-white px-4 py-1.5 rounded-full font-medium shrink-0 transition-colors';
                } else {
                  btn.className = 'cat-pill bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 px-4 py-1.5 rounded-full font-medium shrink-0 hover:bg-slate-50 transition-colors';
                }
              });
              renderOffers();
            }

            function filterOffers() {
              renderOffers();
            }

            // DARK MODE TOGGLE
            function toggleDarkMode() {
              document.documentElement.classList.toggle('dark');
            }

            // MODAL CONTROL
            function openLoginModal() {
              document.getElementById('loginModal').classList.remove('hidden');
            }
            function closeLoginModal() {
              document.getElementById('loginModal').classList.add('hidden');
            }

            function openChatModal() {
              document.getElementById('chatModal').classList.remove('hidden');
            }
            function closeChatModal() {
              document.getElementById('chatModal').classList.add('hidden');
            }

            function openAddOfferModal() {
              document.getElementById('addOfferModal').classList.remove('hidden');
            }
            function closeAddOfferModal() {
              document.getElementById('addOfferModal').classList.add('hidden');
            }

            // CHAT MESSAGE SENDING
            function sendChatMessage(e) {
              e.preventDefault();
              const input = document.getElementById('chatInput');
              const text = input.value.trim();
              if(!text) return;

              const container = document.getElementById('chatMessages');
              const msgHTML = `
                <div class="flex flex-col items-end max-w-[80%] ml-auto animate-in fade-in duration-150">
                  <span class="text-[10px] text-slate-400 mb-0.5">Ty (Teraz)</span>
                  <div class="bg-brand-600 text-white p-3 rounded-2xl rounded-tr-none text-xs shadow-sm">
                    ${text}
                  </div>
                </div>
              `;
              container.innerHTML += msgHTML;
              input.value = '';
              container.scrollTop = container.scrollHeight;
            }

            // ADD NEW OFFER
            function addNewOffer(e) {
              e.preventDefault();
              const title = document.getElementById('newTitle').value;
              const category = document.getElementById('newCategory').value;
              const location = document.getElementById('newLocation').value;
              const image = document.getElementById('newImageUrl').value || 'https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=500&auto=format&fit=crop&q=80';

              const newObj = {
                id: Date.now(),
                title,
                category,
                location,
                image,
                liked: false
              };

              offers.unshift(newObj);
              renderOffers();
              closeAddOfferModal();
            }

            // INIT ON LOAD
            window.onload = function() {
              renderOffers();
            };
    </script>
</body>
</html>